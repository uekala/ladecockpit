# Copy to .env and fill in. Without Tesla and Home Assistant access the app starts in demo mode.

# --- General --------------------------------------------------------------------
# Language of the web app and of the texts sent to Home Assistant: en | de
APP_LANG=en
# Optional: number/date format, e.g. en-GB, en-US, de-DE (default: de-DE for de, en-US for en)
APP_LOCALE=
TZ=Europe/Berlin
# Optional HTTP Basic password for the web app (user name is ignored)
APP_PASSWORD=

# --- Tesla developer app (developer.tesla.com) -------------------------------------
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Must be listed exactly like this as "Allowed Redirect URI" in your developer app.
TESLA_REDIRECT_URI=http://localhost:8077/auth/callback
# eu (Europe, Middle East, Africa) | na (North America, Asia-Pacific)
TESLA_REGION=eu
# Optional, if several cars are on the account:
TESLA_VIN=

# --- Home Assistant (optional, but recommended) -----------------------------------------
# e.g. http://192.168.1.10:8123 (use the IP – .local names often do not resolve inside containers)
HA_URL=
# Profile → Security → Long-lived access tokens
HA_TOKEN=
# Event Ladecockpit fires for every new invoice (the blueprint listens for this one)
HA_EVENT=ladecockpit_invoice
HA_POLL_SECONDS=60

# Your car's entities, e.g. from the Tesla Fleet, Teslemetry or Tessie integration.
# All optional – each one unlocks a feature:
#   battery level → battery card + charging forecast
#   e.g. sensor.my_tesla_battery_level
HA_ENT_SOC=
#   range         → range next to the battery level
#   e.g. sensor.my_tesla_battery_range
HA_ENT_RANGE=
#   odometer      → distance per month and cost per 100 km/mi
#   e.g. sensor.my_tesla_odometer
HA_ENT_ODOMETER=
#   charging      → invoice is fetched right after a session ends
#   e.g. sensor.my_tesla_charging
HA_ENT_CHARGING=
# State of HA_ENT_CHARGING while the car is charging
HA_CHARGING_STATE=charging

# Totals the blueprint books into – used for the "HA vs. invoices" check
HA_ENT_COST_TOTAL=
HA_ENT_KWH_TOTAL=
# Compare invoices with a fixed price you used to estimate costs (entity or number)
HA_ENT_REFERENCE_PRICE=
REFERENCE_PRICE=
# Show fuel cost of another car this month next to the charging cost
HA_ENT_FUEL_MONTH=
FUEL_LABEL=
# What the same distance would have cost with a combustion car (entity wins over the fixed value)
FUEL_CONSUMPTION=
HA_ENT_FUEL_CONSUMPTION=
FUEL_PRICE=
HA_ENT_FUEL_PRICE=
# Charging at home: energy meter of the wallbox (kWh, only increasing) and the electricity price
# (fixed or an entity, e.g. a dynamic tariff – the price at the time of charging is used)
HA_ENT_HOME_ENERGY=
HOME_PRICE=
HA_ENT_HOME_PRICE=
# Outside temperature (sensor or weather entity) for the consumption by temperature
HA_ENT_OUTSIDE_TEMP=

# --- Behaviour ------------------------------------------------------------------------------
# Notification in Home Assistant when the Tesla sign-in expired or syncing keeps failing
NOTIFY_PROBLEMS=true
# Create sensor.ladecockpit_* entities in Home Assistant
PUBLISH_ENTITIES=true
# Notification with last month's summary on the first of the month (the event is always fired)
MONTH_REPORT=true
SOC_FLOOR=10
SOC_TARGET=80
# Regular sync every X hours
SYNC_INTERVAL_H=6
# After a session ends: every X minutes, for at most Y minutes
BURST_INTERVAL_MIN=10
BURST_DURATION_MIN=180
# Invoices older than this are not sent to Home Assistant anymore
PUSH_MAX_AGE_H=72
# Hard limit of Tesla requests per month (1500 ≈ $3)
API_BUDGET_REQUESTS=1500
